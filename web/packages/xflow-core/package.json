{
  "name": "@xflow/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tokens:generate": "tsc -p tsconfig.json && node scripts/generate-tokens.mjs"
  },
  "devDependencies": {
    "@xflow/typescript-config": "workspace:*"
  }
}
