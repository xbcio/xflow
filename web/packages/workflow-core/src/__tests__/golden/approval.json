{
  "name": "approval-flow",
  "nodes": [
    {
      "name": "start",
      "type": "xflow.start",
      "kind": "trigger"
    },
    {
      "name": "request",
      "type": "approval.request",
      "kind": "action",
      "inputs": [
        {
          "name": "approver",
          "required": true
        }
      ],
      "retry": {
        "enabled": true,
        "max_attempts": 3,
        "strategy": "exponential_backoff",
        "initial_interval": 1000,
        "max_interval": 30000,
        "multiplier": 2
      },
      "runnerSelector": {
        "matchLabels": {
          "env": "prod"
        },
        "mode": "required"
      }
    },
    {
      "name": "approve",
      "type": "approval.human",
      "kind": "action",
      "inputs": [
        {
          "name": "decision",
          "required": true
        }
      ]
    },
    {
      "name": "notify",
      "type": "notify.email",
      "kind": "action",
      "inputs": [
        {
          "name": "to",
          "required": true
        }
      ]
    }
  ],
  "connections": {
    "start": {
      "default": [
        {
          "input": "approver",
          "node": "request"
        }
      ]
    },
    "request": {
      "default": [
        {
          "input": "decision",
          "node": "approve"
        }
      ]
    },
    "approve": {
      "approved": [
        {
          "input": "to",
          "node": "notify"
        }
      ]
    }
  },
  "settings": {
    "concurrency": 1,
    "on_error": "fail",
    "pin_data_mode": "off",
    "retry": {
      "enabled": false,
      "max_attempts": 0,
      "strategy": ""
    },
    "timeout": 300,
    "timezone": "UTC"
  }
}
