{
  "name": "cyclic-loop",
  "options": {
    "allow_cycles": true,
    "max_auto_depth": 10
  },
  "nodes": [
    {
      "name": "start",
      "type": "xflow.start",
      "kind": "trigger"
    },
    {
      "name": "loop",
      "type": "xflow.loop",
      "kind": "action"
    },
    {
      "name": "check",
      "type": "xflow.condition",
      "kind": "action"
    }
  ],
  "connections": {
    "start": {
      "default": [
        {
          "node": "loop"
        }
      ]
    },
    "loop": {
      "default": [
        {
          "node": "check"
        }
      ]
    },
    "check": {
      "continue": [
        {
          "node": "loop"
        }
      ]
    }
  }
}
