{
  "name": "basic-demo",
  "namespace": "default",
  "version": "1.0.0",
  "description": "A minimal linear workflow",
  "nodes": [
    {
      "id": "trigger-1",
      "name": "trigger",
      "type": "xflow.start",
      "kind": "trigger",
      "version": 1,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "action-1",
      "name": "hello",
      "type": "xflow.log",
      "kind": "action",
      "disabled": false,
      "inputs": [
        {
          "name": "message",
          "required": true
        }
      ],
      "parameters": {
        "level": "info"
      },
      "position": {
        "x": 300,
        "y": 100
      }
    }
  ],
  "connections": {
    "trigger": {
      "default": [
        {
          "input": "message",
          "node": "hello"
        }
      ]
    }
  },
  "outputs": {
    "greeting": {
      "display_name": "Greeting",
      "value": "nodes.hello.output.message"
    }
  }
}
