{
  "name": "@xflow/preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xflow/core": "workspace:*",
    "@xflow/icons": "workspace:*",
    "@xyflow/react": "12.5.0",
    "antd": "6.5.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@xflow/typescript-config": "workspace:*",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
