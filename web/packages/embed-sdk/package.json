{
  "name": "@xflow/embed-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "iframe embed SDK: createWorkflowEditor / createWorkflowViewer, postMessage protocol, CSP/origin validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@xflow/workflow-editor": "workspace:*",
    "@xflow/workflow-viewer": "workspace:*"
  },
  "devDependencies": {
    "@xflow/typescript-config": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  }
}
