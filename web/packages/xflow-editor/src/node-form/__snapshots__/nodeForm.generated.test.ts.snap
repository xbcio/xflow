          "value": {
            "$bindState": "/parameters/timeout_action",
          },
        },
        "type": "Select",
      },
      "form": {
        "children": [
          "g.type.default",
        ],
        "props": {
          "layout": "vertical",
        },
        "type": "Form",
      },
      "g.type.default": {
        "children": [
          "f.parameters.approvers",
          "f.parameters.mode",
          "f.parameters.timeout",
          "f.parameters.timeout_action",
          "f.parameters.force_approvers",
        ],
        "props": {
          "collapsible": true,
          "title": "参数",
        },
        "type": "FieldGroup",
      },
    },
    "minor": 0,
    "root": "form",
    "spec": "composer/v1",
  },
  "warnings": [],
}
