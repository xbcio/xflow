          },
          "label": "错误处理",
          "mode": "none",
          "observed": {
            "$state": "/on_error",
          },
        },
        "type": "ShapeGuard",
      },
      "f.on_error:control": {
        "props": {
          "description": "未设置时沿用工作流 settings.on_error",
