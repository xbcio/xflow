        },
        "type": "ShapeGuard",
      },
      "f.parameters.code:base64": {
        "checks": [
          {
            "message": "代码中的 \${{ }} 不会被渲染",
            "severity": "warning",
            "type": "noTemplateInCode",
          },
        ],
        "props": {
          "description": "JS source (js) or base64 wasm module (wasm); omit when artifact_digest is set",
          "label": "Code",
          "value": {
            "$bindState": "/parameters/code",
          },
        },
        "type": "TextArea",
        "visible": {
          "$state": "/parameters/language",
          "eq": "wasm",
        },
      },
      "f.parameters.code:code": {
        "checks": [
          {
            "message": "代码中的 \${{ }} 不会被渲染",
            "severity": "warning",
            "type": "noTemplateInCode",
          },
        ],
        "props": {
          "description": "JS source (js) or base64 wasm module (wasm); omit when artifact_digest is set",
          "label": "Code",
          "language": "javascript",
          "value": {
            "$bindState": "/parameters/code",
          },
        },
        "type": "CodeEditor",
        "visible": {
          "$state": "/parameters/language",
          "neq": "wasm",
        },
      },
      "f.parameters.credentials": {
