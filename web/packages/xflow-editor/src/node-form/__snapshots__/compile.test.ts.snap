        "type": "ShapeGuard",
      },
      "f.disabled:control": {
        "props": {
          "defaultHint": false,
          "label": "禁用",
          "value": {
            "$bindState": "/disabled",
          },
        },
        "type": "Switch",
      },
      "f.name": {
