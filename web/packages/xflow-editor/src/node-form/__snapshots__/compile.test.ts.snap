{
  "spec": {
    "elements": {
      "f.parameters.authentication": {
        "props": {
          "description": "Credential reference name",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Authentication",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/authentication",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.authentication:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.authentication:control": {
        "props": {
          "credentials": {
            "$state": "/$ctx/credentials",
          },
          "label": "Authentication",
          "multiple": false,
          "value": {
            "$bindState": "/parameters/authentication",
          },
        },
        "type": "CredentialSelect",
      },
      "f.parameters.body": {
        "props": {
          "description": "Request body, marshalled to JSON. Ignored when mode=raw",
          "expect": {
            "type": "object",
          },
          "fxToggle": true,
          "label": "Body",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/body",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.body:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/mode",
          "in": [
            "json",
            null,
          ],
        },
      },
      "f.parameters.body:control": {
        "props": {
          "label": "Body",
          "value": {
            "$bindState": "/parameters/body",
          },
        },
        "type": "JsonEditor",
      },
      "f.parameters.body_b64": {
        "props": {
          "description": "Request body as base64-encoded bytes, sent verbatim with no Content-Type added. Only read when mode=raw",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Raw Body (base64)",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/body_b64",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.body_b64:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/mode",
          "eq": "raw",
        },
      },
      "f.parameters.body_b64:control": {
        "props": {
          "label": "Raw Body (base64)",
          "value": {
            "$bindState": "/parameters/body_b64",
          },
        },
        "type": "TextArea",
      },
      "f.parameters.headers": {
        "checks": [
          {
            "message": "值看起来像凭据，请改用凭据引用",
            "severity": "warning",
            "type": "secretLike",
          },
        ],
        "props": {
          "description": "Request headers",
          "expect": {
            "type": "object",
            "values": "string",
          },
          "fxToggle": true,
