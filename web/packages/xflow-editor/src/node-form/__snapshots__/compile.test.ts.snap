          "options": [
            {
              "label": "停止",
              "value": "stop",
            },
            {
              "label": "错误端口",
              "value": "error_output",
            },
            {
              "label": "主端口",
              "value": "main_output",
            },
            {
              "label": "继续",
              "value": "continue",
            },
          ],
          "value": {
            "$bindState": "/on_error",
          },
        },
        "type": "Select",
      },
      "f.retry": {
        "children": [
          "f.retry:control",
        ],
        "props": {
          "expect": {
            "type": "object",
          },
          "label": "重试",
          "mode": "none",
          "observed": {
            "$state": "/retry",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.enabled": {
        "children": [
          "f.retry.enabled:control",
        ],
        "props": {
          "expect": {
            "type": "boolean",
          },
          "label": "启用",
          "mode": "none",
          "observed": {
            "$state": "/retry/enabled",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.enabled:control": {
