          "label": "Credentials",
          "multiple": true,
          "value": {
            "$bindState": "/parameters/credentials",
          },
        },
        "type": "CredentialSelect",
      },
      "f.parameters.language": {
        "checks": [
          {
            "message": "必填",
            "type": "required",
          },
        ],
        "props": {
          "description": "Language family: js | wasm (no default — choose explicitly)",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Language",
          "mode": "template",
          "required": true,
          "value": {
            "$bindState": "/parameters/language",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.language:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.language:control": {
        "props": {
          "label": "Language",
          "options": [
            {
              "label": "JavaScript",
              "value": "js",
            },
            {
              "label": "WebAssembly",
              "value": "wasm",
            },
          ],
          "required": true,
          "value": {
            "$bindState": "/parameters/language",
          },
        },
        "type": "Select",
      },
      "f.parameters.roots": {
        "props": {
          "description": "Expression roots the script reads; omit to send the whole environment",
          "expect": {
            "item": "string",
            "type": "array",
          },
          "fxToggle": true,
          "label": "Roots",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/roots",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.roots:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.roots:control": {
        "props": {
          "label": "Roots",
          "value": {
            "$bindState": "/parameters/roots",
          },
        },
        "type": "Tags",
      },
      "f.parameters.runtime": {
        "checks": [
          {
            "message": "必填",
            "type": "required",
          },
        ],
        "props": {
          "description": "Engine: js->goja|qjs, wasm->wazero|wazero-reactor (no default — choose explicitly)",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Runtime",
          "mode": "template",
          "required": true,
          "value": {
            "$bindState": "/parameters/runtime",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.runtime:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.runtime:control": {
        "props": {
          "label": "Runtime",
          "options": {
            "$cond": {
              "$state": "/parameters/language",
              "eq": "js",
            },
            "else": {
              "$cond": {
                "$state": "/parameters/language",
                "eq": "wasm",
              },
              "else": [
                {
                  "label": "goja",
                  "value": "goja",
                },
                {
                  "label": "QuickJS",
                  "value": "qjs",
                },
                {
                  "label": "wazero",
                  "value": "wazero",
                },
                {
                  "label": "wazero (reactor)",
                  "value": "wazero-reactor",
                },
              ],
              "then": [
                {
                  "label": "wazero",
                  "value": "wazero",
                },
                {
                  "label": "wazero (reactor)",
                  "value": "wazero-reactor",
                },
              ],
            },
            "then": [
              {
                "label": "goja",
                "value": "goja",
              },
              {
                "label": "QuickJS",
                "value": "qjs",
              },
            ],
          },
          "required": true,
          "value": {
            "$bindState": "/parameters/runtime",
          },
        },
        "type": "Select",
      },
      "form": {
        "checks": [
          {
            "args": {
              "mode": "exactly",
              "paths": [
                "/parameters/code",
                "/parameters/artifact_digest",
                "/parameters/__artifact_file_path",
              ],
            },
            "message": "Code、Artifact Digest 必须且只能设置一个",
            "targets": [
              "/parameters/code",
              "/parameters/artifact_digest",
            ],
            "type": "oneOf",
          },
        ],
        "children": [
          "g.type.source",
          "g.type.environment",
        ],
        "props": {
          "layout": "vertical",
        },
        "type": "Form",
      },
      "g.type.environment": {
        "children": [
          "f.parameters.credentials",
          "f.parameters.roots",
        ],
        "props": {
          "collapsible": true,
          "title": "Environment",
        },
        "type": "FieldGroup",
      },
      "g.type.source": {
        "children": [
          "f.parameters.language",
          "f.parameters.runtime",
          "f.parameters.code",
          "f.parameters.artifact_digest",
        ],
        "props": {
          "collapsible": true,
          "title": "Source",
        },
        "type": "FieldGroup",
      },
    },
    "minor": 0,
    "root": "form",
    "spec": "composer/v1",
  },
  "warnings": [],
}
`;

