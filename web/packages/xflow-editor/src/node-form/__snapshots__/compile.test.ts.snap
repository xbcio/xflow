          "value": {
            "$bindState": "/retry/enabled",
          },
        },
        "type": "Switch",
      },
      "f.retry.initial_interval": {
        "children": [
          "f.retry.initial_interval:control",
        ],
        "props": {
          "expect": {
            "type": "number",
          },
          "label": "初始间隔",
          "mode": "none",
          "observed": {
            "$state": "/retry/initial_interval",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.initial_interval:control": {
        "props": {
          "defaultHint": 1000,
          "description": "毫秒整数",
          "label": "初始间隔",
          "unit": "ms",
          "value": {
            "$bindState": "/retry/initial_interval",
          },
        },
        "type": "DurationInput",
      },
      "f.retry.max_attempts": {
        "children": [
          "f.retry.max_attempts:control",
        ],
        "props": {
          "expect": {
            "type": "number",
          },
          "label": "最大尝试次数",
