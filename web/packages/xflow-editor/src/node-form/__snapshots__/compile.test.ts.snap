{
  "spec": {
    "elements": {
      "f.parameters.columns": {
        "props": {
          "description": "Columns to select (default: all)",
          "expect": {
            "item": "string",
            "type": "array",
          },
          "fxToggle": true,
          "label": "Columns",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/columns",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.columns:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/operation",
          "eq": "select",
        },
      },
      "f.parameters.columns:control": {
        "props": {
          "label": "Columns",
          "value": {
            "$bindState": "/parameters/columns",
          },
        },
        "type": "Tags",
      },
      "f.parameters.credential": {
        "checks": [
          {
            "message": "必填",
            "type": "required",
          },
        ],
        "props": {
          "description": "Credential reference name for the DB connection",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Credential",
          "mode": "template",
          "required": true,
          "value": {
            "$bindState": "/parameters/credential",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.credential:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.credential:control": {
        "props": {
          "credentials": {
            "$state": "/$ctx/credentials",
          },
          "label": "Credential",
          "multiple": false,
          "required": true,
          "value": {
            "$bindState": "/parameters/credential",
          },
        },
        "type": "CredentialSelect",
      },
      "f.parameters.data": {
        "checks": [
          {
            "message": "当前配置下必填",
            "type": "required",
            "when": {
              "$state": "/parameters/operation",
              "in": [
                "insert",
                "insert_many",
                "update",
              ],
            },
          },
        ],
        "props": {
          "description": "Row data for insert/update operations; an array of row objects for insert_many",
          "expect": {
            "type": "object",
          },
          "fxToggle": true,
          "label": "Data",
          "mode": "template",
          "required": {
            "$cond": {
              "$state": "/parameters/operation",
              "in": [
                "insert",
                "insert_many",
                "update",
              ],
            },
            "else": false,
            "then": true,
          },
          "value": {
            "$bindState": "/parameters/data",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.data:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/operation",
          "in": [
            "insert",
            "insert_many",
            "update",
          ],
        },
      },
      "f.parameters.data:control": {
        "props": {
          "label": "Data",
          "required": {
            "$cond": {
              "$state": "/parameters/operation",
              "in": [
                "insert",
                "insert_many",
                "update",
              ],
            },
            "else": false,
            "then": true,
          },
          "value": {
            "$bindState": "/parameters/data",
          },
        },
        "type": "JsonEditor",
      },
      "f.parameters.limit": {
        "props": {
          "description": "Max rows to return for select",
          "expect": {
            "type": "number",
          },
          "fxToggle": true,
          "label": "Limit",
          "mode": "template",
          "value": {
            "$bindState": "/parameters/limit",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.limit:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/operation",
          "eq": "select",
        },
      },
      "f.parameters.limit:control": {
        "props": {
          "label": "Limit",
          "value": {
            "$bindState": "/parameters/limit",
          },
        },
        "type": "InputNumber",
      },
      "f.parameters.operation": {
        "checks": [
          {
            "message": "必填",
            "type": "required",
          },
        ],
        "props": {
          "description": "DB operation: "select"/"insert"/"update"/"delete"/"insert_many"",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Operation",
          "mode": "template",
          "required": true,
          "value": {
            "$bindState": "/parameters/operation",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.operation:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.operation:control": {
        "props": {
          "label": "Operation",
          "options": [
            {
              "label": "select",
              "value": "select",
            },
            {
              "label": "insert",
              "value": "insert",
            },
            {
              "label": "update",
              "value": "update",
            },
            {
              "label": "delete",
              "value": "delete",
            },
            {
              "label": "insert_many",
              "value": "insert_many",
            },
          ],
          "required": true,
          "value": {
            "$bindState": "/parameters/operation",
          },
        },
        "type": "Select",
      },
      "f.parameters.table": {
        "checks": [
          {
            "message": "必填",
            "type": "required",
          },
          {
            "args": {
              "args": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              },
              "check": "pattern",
            },
            "message": "需要匹配 ^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "literalOnly",
          },
          {
            "args": {
              "args": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              },
              "check": "pattern",
            },
            "message": "需要匹配 ^[A-Za-z_][A-Za-z0-9_]*$",
            "severity": "warning",
            "type": "expressionOnly",
          },
        ],
        "props": {
          "description": "Target table name",
          "expect": {
            "type": "string",
          },
          "fxToggle": true,
          "label": "Table",
          "mode": "template",
          "required": true,
          "value": {
            "$bindState": "/parameters/table",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.table:control",
          ],
        },
        "type": "ExpressionInput",
      },
      "f.parameters.table:control": {
        "props": {
          "label": "Table",
          "required": true,
          "value": {
            "$bindState": "/parameters/table",
          },
        },
        "type": "Input",
      },
      "f.parameters.where": {
        "checks": [
          {
            "message": "当前配置下必填",
            "type": "required",
            "when": {
              "$state": "/parameters/operation",
              "in": [
                "update",
                "delete",
              ],
            },
          },
        ],
        "props": {
          "description": "Filter conditions (key-value pairs)",
          "expect": {
            "type": "object",
          },
          "fxToggle": true,
          "label": "Where",
          "mode": "template",
          "required": {
            "$cond": {
              "$state": "/parameters/operation",
              "in": [
                "update",
                "delete",
              ],
            },
            "else": false,
            "then": true,
          },
          "value": {
            "$bindState": "/parameters/where",
          },
        },
        "slots": {
          "literal": [
            "f.parameters.where:control",
          ],
        },
        "type": "ExpressionInput",
        "visible": {
          "$state": "/parameters/operation",
          "in": [
            "select",
            "update",
            "delete",
          ],
        },
      },
      "f.parameters.where:control": {
        "props": {
          "label": "Where",
          "required": {
            "$cond": {
              "$state": "/parameters/operation",
              "in": [
                "update",
                "delete",
              ],
            },
            "else": false,
            "then": true,
          },
          "value": {
            "$bindState": "/parameters/where",
          },
        },
        "type": "JsonEditor",
      },
      "form": {
        "children": [
          "g.type.default",
        ],
        "props": {
          "layout": "vertical",
        },
        "type": "Form",
      },
      "g.type.default": {
        "children": [
          "f.parameters.operation",
          "f.parameters.table",
          "f.parameters.credential",
          "f.parameters.where",
          "f.parameters.data",
