        ],
        "props": {
          "expect": {
            "type": "number",
          },
          "label": "最大间隔",
          "mode": "none",
          "observed": {
            "$state": "/retry/max_interval",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.max_interval:control": {
        "props": {
          "defaultHint": 300000,
          "description": "毫秒整数；单次等待另有 5 分钟上限",
          "label": "最大间隔",
          "unit": "ms",
          "value": {
            "$bindState": "/retry/max_interval",
          },
        },
        "type": "DurationInput",
      },
      "f.retry.multiplier": {
        "children": [
          "f.retry.multiplier:control",
        ],
        "props": {
          "expect": {
            "type": "number",
          },
          "label": "倍率",
          "mode": "none",
          "observed": {
            "$state": "/retry/multiplier",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.multiplier:control": {
        "props": {
          "defaultHint": 2,
          "label": "倍率",
          "value": {
            "$bindState": "/retry/multiplier",
          },
        },
        "type": "InputNumber",
      },
      "f.retry.strategy": {
        "children": [
          "f.retry.strategy:control",
        ],
        "props": {
          "expect": {
            "type": "string",
          },
          "label": "策略",
          "mode": "none",
          "observed": {
            "$state": "/retry/strategy",
          },
        },
        "type": "ShapeGuard",
      },
      "f.retry.strategy:control": {
        "props": {
          "label": "策略",
          "options": [
            {
              "label": "固定间隔",
              "value": "fixed",
            },
            {
              "label": "指数退避",
              "value": "exponential",
            },
          ],
          "value": {
            "$bindState": "/retry/strategy",
          },
        },
        "type": "Select",
      },
      "f.retry:control": {
        "children": [
          "f.retry.enabled",
          "f.retry.max_attempts",
          "f.retry.strategy",
          "f.retry.initial_interval",
          "f.retry.max_interval",
          "f.retry.multiplier",
        ],
        "props": {
          "description": "覆盖工作流 settings.retry；未设置时继承",
          "label": "重试",
          "value": {
            "$bindState": "/retry",
          },
        },
        "type": "ObjectGroup",
      },
      "f.runner_selector": {
        "children": [
          "f.runner_selector:control",
        ],
        "props": {
          "expect": {
            "type": "object",
          },
          "label": "Runner 选择",
          "mode": "none",
          "observed": {
            "$state": "/runner_selector",
          },
        },
        "type": "ShapeGuard",
      },
      "f.runner_selector.match_labels": {
        "children": [
          "f.runner_selector.match_labels:control",
        ],
        "props": {
          "expect": {
            "type": "object",
            "values": "string",
          },
          "label": "匹配标签",
          "mode": "none",
          "observed": {
            "$state": "/runner_selector/match_labels",
          },
        },
        "type": "ShapeGuard",
      },
      "f.runner_selector.match_labels:control": {
        "checks": [
          {
            "message": "值看起来像凭据，请改用凭据引用",
            "severity": "warning",
            "type": "secretLike",
          },
        ],
        "props": {
          "label": "匹配标签",
          "value": {
            "$bindState": "/runner_selector/match_labels",
          },
        },
        "type": "KeyValue",
      },
      "f.runner_selector:control": {
        "children": [
          "f.runner_selector.match_labels",
        ],
        "props": {
          "description": "节点级只支持 match_labels；mode 只能写在工作流级",
          "label": "Runner 选择",
          "value": {
            "$bindState": "/runner_selector",
          },
        },
        "type": "ObjectGroup",
      },
      "f.timeout": {
        "children": [
          "f.timeout:control",
        ],
        "props": {
          "expect": {
            "type": "number",
          },
          "label": "超时",
          "mode": "none",
          "observed": {
            "$state": "/timeout",
          },
        },
        "type": "ShapeGuard",
      },
      "f.timeout:control": {
        "props": {
          "description": "单次执行的超时（线上为纳秒整数）；未设置继承引擎默认值，负值表示不限",
          "label": "超时",
          "unit": "ns",
          "value": {
            "$bindState": "/timeout",
          },
        },
        "type": "DurationInput",
      },
      "form": {
        "children": [
          "n.unregistered-type",
          "g.common.general",
          "g.common.execution",
        ],
        "props": {
          "layout": "vertical",
        },
        "type": "Form",
      },
      "g.common.execution": {
        "children": [
          "f.on_error",
          "f.timeout",
          "f.retry",
          "f.runner_selector",
        ],
        "props": {
          "collapsible": true,
          "defaultCollapsed": true,
          "title": "执行策略",
        },
        "type": "FieldGroup",
      },
      "g.common.general": {
        "children": [
          "f.name",
          "f.disabled",
          "f.notes",
        ],
        "props": {
          "collapsible": true,
          "title": "通用",
        },
        "type": "FieldGroup",
      },
      "n.unregistered-type": {
        "props": {
          "code": "unregistered-type",
          "message": "该节点类型未在 server 注册，参数按 JSON 编辑",
          "tone": "warning",
        },
        "type": "FormNotice",
      },
    },
    "minor": 0,
    "root": "form",
    "spec": "composer/v1",
  },
  "warnings": [],
}
`;

