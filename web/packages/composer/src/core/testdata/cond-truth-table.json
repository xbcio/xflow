{
  "description": "Shared condition truth table (Doc B §3.3, Doc A §2.2). Each case evaluates `cond` against the state `value`; `expected` is the resulting boolean. `error: true` marks an evaluation error, whose result is always true (the element stays visible and reports the error). Missing paths compare as null; `truthy` is JavaScript truthiness; numbers compare numerically; all branches of $and/$or are evaluated, so an error anywhere makes the whole condition true.",
  "cases": [
    { "name": "literal true", "cond": true, "value": {}, "expected": true },
    { "name": "literal false", "cond": false, "value": {}, "expected": false },

    { "name": "eq string match", "cond": { "$state": "/mode", "eq": "signal" }, "value": { "mode": "signal" }, "expected": true },
    { "name": "eq string mismatch", "cond": { "$state": "/mode", "eq": "signal" }, "value": { "mode": "timer" }, "expected": false },
    { "name": "eq null on missing path", "cond": { "$state": "/mode", "eq": null }, "value": {}, "expected": true },
    { "name": "eq null on explicit null", "cond": { "$state": "/mode", "eq": null }, "value": { "mode": null }, "expected": true },
    { "name": "eq null on empty string", "cond": { "$state": "/mode", "eq": null }, "value": { "mode": "" }, "expected": false },
    { "name": "neq null on missing path", "cond": { "$state": "/mode", "neq": null }, "value": {}, "expected": false },
    { "name": "neq null on set value", "cond": { "$state": "/mode", "neq": null }, "value": { "mode": "x" }, "expected": true },
    { "name": "eq on missing nested parent", "cond": { "$state": "/a/b/c", "eq": null }, "value": { "a": 1 }, "expected": true },
    { "name": "eq value on missing path", "cond": { "$state": "/mode", "eq": "signal" }, "value": {}, "expected": false },
    { "name": "neq value on missing path", "cond": { "$state": "/mode", "neq": "signal" }, "value": {}, "expected": true },

    { "name": "eq int vs float", "cond": { "$state": "/n", "eq": 1 }, "value": { "n": 1.0 }, "expected": true },
    { "name": "eq float vs int", "cond": { "$state": "/n", "eq": 2.0 }, "value": { "n": 2 }, "expected": true },
    { "name": "eq number vs numeric string", "cond": { "$state": "/n", "eq": 1 }, "value": { "n": "1" }, "expected": false },
    { "name": "eq zero vs false", "cond": { "$state": "/n", "eq": 0 }, "value": { "n": false }, "expected": false },
    { "name": "eq boolean", "cond": { "$state": "/b", "eq": true }, "value": { "b": true }, "expected": true },
    { "name": "eq array deep", "cond": { "$state": "/a", "eq": [1, "x"] }, "value": { "a": [1.0, "x"] }, "expected": true },
    { "name": "eq object deep", "cond": { "$state": "/o", "eq": { "k": 1 } }, "value": { "o": { "k": 1 } }, "expected": true },
    { "name": "eq object key mismatch", "cond": { "$state": "/o", "eq": { "k": 1 } }, "value": { "o": { "k": 1, "j": 2 } }, "expected": false },

    { "name": "in match", "cond": { "$state": "/mode", "in": ["signal", null] }, "value": { "mode": "signal" }, "expected": true },
    { "name": "in null matches missing", "cond": { "$state": "/mode", "in": ["signal", null] }, "value": {}, "expected": true },
    { "name": "in no match", "cond": { "$state": "/mode", "in": ["signal", null] }, "value": { "mode": "timer" }, "expected": false },
    { "name": "in numeric normalisation", "cond": { "$state": "/n", "in": [1, 2] }, "value": { "n": 2.0 }, "expected": true },
    { "name": "in empty list", "cond": { "$state": "/n", "in": [] }, "value": { "n": 1 }, "expected": false },
    { "name": "in non-array operand is error", "cond": { "$state": "/n", "in": "x" }, "value": { "n": 1 }, "expected": true, "error": true },

    { "name": "truthy empty array", "cond": { "$state": "/v", "truthy": true }, "value": { "v": [] }, "expected": true },
    { "name": "truthy empty object", "cond": { "$state": "/v", "truthy": true }, "value": { "v": {} }, "expected": true },
    { "name": "truthy string zero", "cond": { "$state": "/v", "truthy": true }, "value": { "v": "0" }, "expected": true },
    { "name": "truthy empty string", "cond": { "$state": "/v", "truthy": true }, "value": { "v": "" }, "expected": false },
    { "name": "truthy number zero", "cond": { "$state": "/v", "truthy": true }, "value": { "v": 0 }, "expected": false },
    { "name": "truthy false", "cond": { "$state": "/v", "truthy": true }, "value": { "v": false }, "expected": false },
    { "name": "truthy null", "cond": { "$state": "/v", "truthy": true }, "value": { "v": null }, "expected": false },
    { "name": "truthy missing", "cond": { "$state": "/v", "truthy": true }, "value": {}, "expected": false },
    { "name": "truthy nonzero number", "cond": { "$state": "/v", "truthy": true }, "value": { "v": -1 }, "expected": true },
    { "name": "falsy check on missing", "cond": { "$state": "/v", "truthy": false }, "value": {}, "expected": true },
    { "name": "falsy check on value", "cond": { "$state": "/v", "truthy": false }, "value": { "v": "x" }, "expected": false },
    { "name": "truthy non-boolean operand is error", "cond": { "$state": "/v", "truthy": 1 }, "value": { "v": 1 }, "expected": true, "error": true },

    { "name": "gt true", "cond": { "$state": "/n", "gt": 1 }, "value": { "n": 2 }, "expected": true },
    { "name": "gt equal", "cond": { "$state": "/n", "gt": 2 }, "value": { "n": 2.0 }, "expected": false },
    { "name": "gte equal", "cond": { "$state": "/n", "gte": 2 }, "value": { "n": 2.0 }, "expected": true },
    { "name": "lt true", "cond": { "$state": "/n", "lt": 0 }, "value": { "n": -0.5 }, "expected": true },
    { "name": "lte false", "cond": { "$state": "/n", "lte": 1 }, "value": { "n": 1.5 }, "expected": false },
    { "name": "gt on string is error", "cond": { "$state": "/n", "gt": 1 }, "value": { "n": "5" }, "expected": true, "error": true },
    { "name": "gt on missing is error", "cond": { "$state": "/n", "gt": 1 }, "value": {}, "expected": true, "error": true },
    { "name": "lt on boolean is error", "cond": { "$state": "/n", "lt": 1 }, "value": { "n": false }, "expected": true, "error": true },
    { "name": "gt with string operand is error", "cond": { "$state": "/n", "gt": "1" }, "value": { "n": 5 }, "expected": true, "error": true },

    { "name": "and all true", "cond": { "$and": [{ "$state": "/a", "eq": 1 }, { "$state": "/b", "truthy": true }] }, "value": { "a": 1, "b": [] }, "expected": true },
    { "name": "and one false", "cond": { "$and": [{ "$state": "/a", "eq": 1 }, { "$state": "/b", "truthy": true }] }, "value": { "a": 1 }, "expected": false },
    { "name": "and empty", "cond": { "$and": [] }, "value": {}, "expected": true },
    { "name": "implicit and array", "cond": [{ "$state": "/a", "eq": 1 }, { "$state": "/b", "eq": 2 }], "value": { "a": 1, "b": 2 }, "expected": true },
    { "name": "implicit and array false", "cond": [{ "$state": "/a", "eq": 1 }, false], "value": { "a": 1 }, "expected": false },
    { "name": "or one true", "cond": { "$or": [{ "$state": "/a", "eq": 1 }, { "$state": "/b", "eq": 2 }] }, "value": { "b": 2 }, "expected": true },
    { "name": "or none true", "cond": { "$or": [{ "$state": "/a", "eq": 1 }, { "$state": "/b", "eq": 2 }] }, "value": {}, "expected": false },
    { "name": "or empty", "cond": { "$or": [] }, "value": {}, "expected": false },
    { "name": "not true", "cond": { "$not": { "$state": "/a", "eq": 1 } }, "value": { "a": 1 }, "expected": false },
    { "name": "not missing eq null", "cond": { "$not": { "$state": "/a", "eq": null } }, "value": {}, "expected": false },
    { "name": "nested combinators", "cond": { "$and": [{ "$state": "/mode", "eq": "signal" }, { "$or": [{ "$not": { "$state": "/q", "eq": null } }, { "$state": "/signals", "truthy": true }] }] }, "value": { "mode": "signal", "signals": ["a"] }, "expected": true },

    { "name": "error inside and makes whole condition true", "cond": { "$and": [false, { "$state": "/n", "gt": 1 }] }, "value": { "n": "x" }, "expected": true, "error": true },
    { "name": "error inside not makes whole condition true", "cond": { "$not": { "$state": "/n", "gt": 1 } }, "value": { "n": "x" }, "expected": true, "error": true },
    { "name": "error in later or branch is still reported", "cond": { "$or": [true, { "$state": "/n", "lt": 1 }] }, "value": {}, "expected": true, "error": true },

    { "name": "pointer escape ~1", "cond": { "$state": "/a~1b", "eq": 1 }, "value": { "a/b": 1 }, "expected": true },
    { "name": "pointer escape ~0", "cond": { "$state": "/a~0b", "eq": 1 }, "value": { "a~b": 1 }, "expected": true },
    { "name": "array index path", "cond": { "$state": "/list/1", "eq": "y" }, "value": { "list": ["x", "y"] }, "expected": true },
    { "name": "array index out of range is missing", "cond": { "$state": "/list/5", "eq": null }, "value": { "list": ["x"] }, "expected": true }
  ]
}
