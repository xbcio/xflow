{
  "name": "@xflow/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Replaceable HTTP transport, AbortSignal support, unified error taxonomy, ETag/409 mapping",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
