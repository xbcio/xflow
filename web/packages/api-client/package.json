    "test": "vitest run"
  },
  "dependencies": {
    "@xflow/workflow-core": "workspace:*"
  },
  "devDependencies": {
    "@xflow/typescript-config": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  }
}
