{
  "name": "@xflow/workflow-components",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow-specific UI components reused by at least two applications (not a generic design system)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@xflow/node-registry": "workspace:*",
    "@xflow/workflow-core": "workspace:*",
    "@xflow/workflow-provider": "workspace:*",
    "@xflow/workflow-renderer": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@xyflow/react": "12.5.0"
  },
  "peerDependenciesMeta": {
    "@xyflow/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@xflow/typescript-config": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  }
}
