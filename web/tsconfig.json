{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@xflow/typescript-config/react",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@xflow/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
