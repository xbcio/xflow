{
  "name": "@xflow/web",
  "version": "0.1.0",
  "private": true,
  "description": "XFlow frontend workspace",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "22.15.0",
    "pnpm": ">=10.10.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @xflow/admin dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:production-fixtures": "node scripts/check-production-fixtures.mjs",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.25.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.15.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.10",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "3.2.0",
    "eslint": "9.25.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "turbo": "2.5.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.0"
  }
}
