#!/usr/bin/env sh
# Enforces Conventional Commits: https://www.conventionalcommits.org
set -e

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-zA-Z0-9_/-]+\))?(!)?: .{1,100}$'

# Strip comment lines before checking
FIRST_LINE=$(echo "$MSG" | grep -v '^#' | head -1)

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✗ commit message does not follow Conventional Commits"
  echo ""
  echo "  Format:  <type>(<scope>): <description>"
  echo "  Example: feat(engine): add retry policy for failed tasks"
  echo ""
  echo "  Allowed types: feat fix docs style refactor perf test chore ci build revert"
  echo ""
  echo "  Got: $FIRST_LINE"
  echo ""
  exit 1
fi
