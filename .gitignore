### Go template
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file (create locally: go work init && go work use . ./node ./types ./sdk)
go.work
go.work.sum

# Stray test output
test_output.txt

# A0 fault matrix artifact is generated per CI run; never check it in.
test/integration/testdata/a0_fault_matrix_report.json

# G1 production e2e bundle is generated per CI run; never check it in. The
# UUID-named report/event generations are authoritative through the manifest;
# the fixed report/event names are compatibility aliases.
test/integration/testdata/g1_e2e_report.json
test/integration/testdata/g1_e2e_events.json
test/integration/testdata/g1_e2e_manifest.json
test/integration/testdata/g1-evidence-*.report.json
test/integration/testdata/g1-evidence-*.events.json

# G0 evidence run artifacts (raw fragments + merged go-test json + final
# artifact + fixed test binary) are generated per `make
# test-g0-evidence-required` run; never check them in. The fixed test binary
# is also covered by *.test above.
test/integration/testdata/evidence/
test/integration/testdata/g0-evidence.json

# env file
.env

.idea

docs/archive
docs/superpowers
docs/plans.worktrees
.worktrees/
bin/
data/

# Codex build/module cache
.codex-gocache/
.codex-gomodcache/
.tmp/

# Claude Code local files
.claude/worktrees/
.claude/plans/
.claude/sdd/
.claude/superpowers/
.claude/mockups/
.claude/settings.local.json
.claude/specs/
.claude/archive-*.tar.gz
.claude/.delete-list.txt

# Superpowers internal reports (local-only; some historical files remain tracked
# but new reports should not enter the repo).
.superpowers/

# Editor local settings
.vscode/
.DS_Store

# pnpm store (web monorepo)
.pnpm-store/

# Agent workspace artifacts
.agents/

# Built binaries at the repo root. The leading slash is load-bearing: a bare
# "runner" pattern matches every path segment containing that name, which
# silently excluded cmd/runner/*_test.go from the repository.
/runner
/server
/xflow

# 截图/图片：曾有一张整屏截图带人名与内部运维台被提交并公开（b92f00c）
.claude/*.png
.claude/*.jpg
.claude/*.jpeg

# 部署验证记录：内容是某一次真实部署的现场结论——消费组名、对方私有仓的
# 文件路径、按接口算的丢失率。这是公开仓库，这类记录的归宿是内部，不是这里。
# 路径带斜杠，所以只匹配仓库根下的这一个文件，不会像裸词那样吞掉同名目录。
docs/xflow-verification-findings.md
